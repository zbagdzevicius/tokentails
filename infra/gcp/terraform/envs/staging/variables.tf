# ---------------------------------------------------------------------------------------------------------------------
# Project guard: the throwaway staging project only. Production (gleaming-medium-480114-g5) has its own root
# (../prod); motored-* projects belong to another company.

variable "project_id" {
  description = "Must be tokentails-staging. No default on purpose."
  type        = string

  validation {
    condition     = var.project_id == "tokentails-staging" && !startswith(var.project_id, "motored")
    error_message = "envs/staging targets tokentails-staging only. Production is envs/prod; motored-* and any other project are refused."
  }
}

variable "region" {
  type    = string
  default = "europe-west3"
}

variable "zones" {
  description = "One zone is enough for a test stack."
  type        = list(string)
  default     = ["europe-west3-a"]
}

variable "environment" {
  type    = string
  default = "staging"
}

# ---------------------------------------------------------------------------------------------------------------------
# Reachability without DNS

variable "domain" {
  description = "Fake hostnames under the reserved .test TLD: nothing resolves them; use curl --resolve or a Host header."
  type        = string
  default     = "staging.tokentails.test"

  validation {
    condition     = endswith(var.domain, ".test")
    error_message = "Staging hostnames stay under the reserved .test TLD (no real DNS, no Cloudflare)."
  }
}

variable "operator_cidrs" {
  description = "The operator's public address(es) Cloud Armor admits besides Cloudflare (curl -s https://api.ipify.org)/32."
  type        = list(string)

  validation {
    condition = length(var.operator_cidrs) > 0 && alltrue([
      for c in var.operator_cidrs : can(cidrhost(c, 0)) && (strcontains(c, ":") ? tonumber(split("/", c)[1]) >= 48 : tonumber(split("/", c)[1]) >= 24)
    ])
    error_message = "Give your own address as a /32 (IPv4 /24 or narrower, IPv6 /48 or narrower). Never 0.0.0.0/0."
  }
}

variable "cert_validity_hours" {
  description = "Self-signed load balancer certificate lifetime."
  type        = number
  default     = 168
}

# ---------------------------------------------------------------------------------------------------------------------
# Images

variable "backend_tag" {
  type = string
}

variable "web_tag" {
  type = string
}

variable "cms_tag" {
  type = string
}

# ---------------------------------------------------------------------------------------------------------------------
# Sizing: small and cheap. Everything is deleted after the test.

variable "relay_machine_type" {
  type    = string
  default = "e2-standard-2"
}

variable "max_live_rooms" {
  description = "PARTY_MAX_LIVE_ROOMS on the relay (and the 80 % alert). Raise it for a load run past the default cap."
  type        = number
  default     = 60
}

variable "mongo_machine_type" {
  type    = string
  default = "e2-small"
}

variable "mongo_ip" {
  description = "Static internal address of the throwaway mongo:7 VM (inside the main subnet 10.10.0.0/20)."
  type        = string
  default     = "10.10.0.50"

  validation {
    condition     = startswith(var.mongo_ip, "10.10.")
    error_message = "mongo_ip must be inside the main subnet 10.10.0.0/20."
  }
}

variable "api" {
  type = object({
    cpu           = string
    memory        = string
    min_instances = number
    max_instances = number
    concurrency   = number
  })
  default = {
    cpu           = "1"
    memory        = "1Gi"
    min_instances = 1
    max_instances = 1
    concurrency   = 40
  }
}

variable "web" {
  type = object({
    cpu           = string
    memory        = string
    min_instances = number
    max_instances = number
  })
  default = {
    cpu           = "1"
    memory        = "1Gi"
    min_instances = 0
    max_instances = 1
  }
}

variable "cms" {
  type = object({
    cpu           = string
    memory        = string
    min_instances = number
    max_instances = number
  })
  default = {
    cpu           = "1"
    memory        = "512Mi"
    min_instances = 0
    max_instances = 1
  }
}

variable "api_extra_env" {
  description = "Plain env on tt-api besides NODE_ENV/BACKEND_ROLE. Crons off by default (no real keys in staging); set CRONS_ENABLED=true to test the leases."
  type        = map(string)
  default = {
    CRONS_ENABLED       = "false"
    IMPACT_JOBS_ENABLED = "false"
  }
}

# ---------------------------------------------------------------------------------------------------------------------
# Secrets: throwaway values only, generated by scripts/staging-secrets.sh (openssl rand) and added with gcloud.
# Never a production value.

variable "secret_keys" {
  description = "Secrets the staging stack mounts on tt-api, each at version 1 (the least the api role boots with)."
  type        = list(string)
  default = [
    "MONGODB_URI", "FRONT_END_URLS", "OPENAI_API_KEY", "INVALIDATE_CACHE_SECRET", "FB_PRIVATE_KEY",
    "PAWLEGENDS_PARTY_TICKET_SECRET",
  ]
}

variable "relay_secret_keys" {
  type    = list(string)
  default = ["MONGODB_URI", "PAWLEGENDS_PARTY_TICKET_SECRET", "FRONT_END_URLS"]
}

variable "hot_wallet_secret_keys" {
  description = "Readable by sa-api only (same rule as production)."
  type        = list(string)
  default     = ["SHELTER_DONATE_PRIVATE_KEY", "INVALIDATE_CACHE_SECRET", "SHELTER_TRY_PRIVATE_KEY"]
}

