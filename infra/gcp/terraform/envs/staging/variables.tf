variable "monitoring_enabled" {
  description = "Create the monitoring module (alerts, uptime checks). Off: staging hosts do not resolve, uptime checks would only page."
  type        = bool
  default     = false
}

variable "alert_email" {
  description = "Needed only when monitoring_enabled or budget_enabled."
  type        = string
  default     = null
}

variable "budget_enabled" {
  description = "Create a billing budget. Off by default: it needs billing-account rights (billing.costsManager) the staging operator may lack."
  type        = bool
  default     = false
}

variable "billing_account" {
  description = "Needed only when budget_enabled."
  type        = string
  default     = null
}

variable "budget_amount" {
  type    = number
  default = 15
}

variable "static_bucket_enabled" {
  description = "Create the media bucket (force_destroy on, so destroy empties it)."
  type        = bool
  default     = false
}
