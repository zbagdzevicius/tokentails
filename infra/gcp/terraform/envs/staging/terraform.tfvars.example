# Copy to terraform.tfvars (gitignored). The throwaway staging stack (RUNBOOK.md "Staging"). No secret goes here:
# throwaway secret values are generated by scripts/staging-secrets.sh and added with gcloud.
project_id = "tokentails-staging"

# Your own public address (curl -s https://api.ipify.org): Cloud Armor admits it besides Cloudflare. Never 0.0.0.0/0.
operator_cidrs = ["203.0.113.7/32"]

# Images pushed to europe-west3-docker.pkg.dev/tokentails-staging/tokentails (RUNBOOK.md "Staging", step 3).
backend_tag = "REPLACE_WITH_SHA"
web_tag     = "REPLACE_WITH_SHA"
cms_tag     = "REPLACE_WITH_SHA"

# Optional (defaults shown)
# monitoring_enabled = false            # true needs alert_email
# budget_enabled     = false            # true needs billing_account and billing-account rights (billing.costsManager)
# api_extra_env      = { CRONS_ENABLED = "false", IMPACT_JOBS_ENABLED = "false" }
