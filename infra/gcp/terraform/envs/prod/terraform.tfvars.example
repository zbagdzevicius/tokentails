# Copy to terraform.tfvars (gitignored) and fill in. No secret goes here: secret VALUES are added with gcloud
# (RUNBOOK.md step 3). project_id is gleaming-medium-480114-g5 (production); only it and tokentails-staging pass validation, motored-* is refused.
project_id      = "gleaming-medium-480114-g5"
billing_account = "000000-000000-000000"
alert_email     = "founder@example.com"

# First images (git SHAs pushed by the build-only run of deploy-gcp.yml); CI owns later images.
backend_tag = "REPLACE_WITH_SHA"
web_tag     = "REPLACE_WITH_SHA"
cms_tag     = "REPLACE_WITH_SHA"

# Optional overrides (defaults shown)
# region             = "europe-west3"
# zones              = ["europe-west3-a", "europe-west3-b", "europe-west3-c"]
# relay_machine_type = "t2d-standard-2"
# max_live_rooms     = 60
# budget_amount      = 400
# budget_currency    = "USD"
# state_bucket       = "gleaming-medium-480114-g5-tfstate"
# ci_apply_enabled   = false
