{
  "name": "catnip-heist",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Catnip Heist v1: single-player voxel pixel-art stealth game for Token Tails",
  "scripts": {
    "import-assets": "node scripts/import-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "solve": "node tools/solve.mjs",
    "build-level": "node tools/build-levels.mjs",
    "export-glb": "node tools/export-glb.mjs"
  },
  "dependencies": {
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.183.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
