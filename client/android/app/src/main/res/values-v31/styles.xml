<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash in night (plan G6). The platform draws this splash itself, before
         any app drawable, so its background is set with the framework attributes as well as the
         core-splashscreen ones in values/styles.xml. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tt_night_900</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">@color/tt_night_900</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/tt_night_900</item>
    </style>
</resources>
