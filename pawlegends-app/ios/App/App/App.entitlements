<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac (Mac Catalyst) only: CODE_SIGN_ENTITLEMENTS[sdk=macosx*]. The Mac App Store requires the App Sandbox; the
	     game talks to api.tokentails.com (REST, party WebSocket) and tokentails.com (OTA manifests and bundles). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
