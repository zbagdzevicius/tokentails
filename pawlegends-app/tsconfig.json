{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "../pawlegends-web/*"
      ],
      "firebase/*": [
        "./node_modules/firebase/*"
      ],
      "@capacitor-firebase/authentication": [
        "./node_modules/@capacitor-firebase/authentication"
      ],
      "@capacitor/core": [
        "./node_modules/@capacitor/core"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "capacitor.config.ts",
    "vitest.config.ts"
  ]
}
