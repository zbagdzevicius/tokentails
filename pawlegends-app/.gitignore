node_modules/
# built by scripts/build-web.mjs (the app copies it into ios/App/App/public on cap sync)
www/
# the compat-1 bridge bundle (scripts/build-web.mjs --bridge)
www-bridge/
# the node_modules symlink of a worktree
node_modules
# OTA signing private key: never commit (GitHub secret OTA_PRIVATE_KEY)
ota/.keys/
*.pem.private
# fastlane / bundler local state and secrets
vendor/bundle/
.bundle/
fastlane/.secrets.local
fastlane/*.p8
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
build/
*.ipa
*.dSYM.zip
# screenshots are generated (scripts/screenshots.mjs) into fastlane/screenshots
.DS_Store
*.log
fastlane/README.md
# Android: the upload key lives outside the repo (~/.tokentails-keys, GitHub secrets); never commit one
*.jks
*.keystore
*.aab
*.apk
play-service-account*.json
