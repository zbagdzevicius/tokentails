# Copy to fastlane/.secrets.local (gitignored) for local runs; CI reads the same names from GitHub Actions secrets.
# App Store Connect → Users and Access → Integrations → App Store Connect API → Team Keys. Role: Admin (so Xcode
# cloud signing can make the distribution certificate) or App Manager (then run `bundle exec fastlane certs` once).
ASC_KEY_ID=AP7D5SQU7F
ASC_ISSUER_ID=
# The .p8 file content, base64 (base64 -i AuthKey_XXXX.p8 | tr -d '\n'), or the PEM text on one line with \n.
ASC_KEY_P8=
APPLE_TEAM_ID=BVLDTU9V83
