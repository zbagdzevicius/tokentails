{
  "name": "pawlegends-app",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Pawlegends native shell: the bundled iOS app (Capacitor 7) with self-hosted over-the-air web updates. Plan: docs/plans/moba/APP-STORE.md",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build": "node scripts/build-web.mjs && cap sync ios && node scripts/check-privacy-manifests.mjs",
    "sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:sim": "node scripts/build-sim.mjs",
    "mac": "node scripts/build-mac.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "ota:keygen": "node scripts/ota-keygen.mjs",
    "ota:publish": "node scripts/ota-publish.mjs",
    "ota:local": "node scripts/ota-local.mjs",
    "privacy:check": "node scripts/check-privacy-manifests.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "~7.6.0",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "~7.6.0",
    "@capgo/capacitor-updater": "7.53.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~7.6.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
